# --- Solari ---
# Leave SOLARI_API_KEY unset to run Tenfold in MOCK MODE: no real browsers are
# launched, no cost is incurred, and the fanout/analyze pipeline runs against a
# deterministic simulated Flakemart so the whole system is demoable with zero
# signup. Set it to a real key to launch real cloud Chrome sessions.
SOLARI_API_KEY=

# --- LLM backend (Groq — free tier, OpenAI-compatible) ---
# Same mock-fallback behavior: unset => plan compilation and step resolution
# use a small deterministic local "compiler" instead of calling the LLM.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
PLAN_MODEL=openai/gpt-oss-120b
RESOLVE_MODEL=openai/gpt-oss-20b

# --- Persistence ---
# Any Postgres connection string (Neon, Render, Railway, local) works against
# infra/schema.sql. If unset, the runner falls back to a local SQLite file
# (infra/tenfold.db) with an equivalent schema — zero-setup for local/demo use.
DATABASE_URL=

# --- Budget guardrails (demo mode only; ignored in BYOK mode) ---
DAILY_BUDGET_USD=3.00
MAX_RUNS_PER_IP_PER_DAY=5
DEFAULT_N=10
MAX_N=15
HARD_DEADLINE_MS=120000
PER_STEP_TIMEOUT_MS=15000
REPLAY_POLL_TIMEOUT_MS=30000

# --- Workflow Memory (§11) ---
# How many bits (of 64) the current page's aria-snapshot fingerprint may
# differ from a remembered one before Tenfold distrusts the old locator and
# re-resolves. Lower = stricter (relearns more often, safer); higher =
# tolerates more drift before relearning. The CLI persists memory to a JSON
# file next to the plan by default; the runner uses step_memory in Postgres
# when DATABASE_URL is set, an in-process Map otherwise (lost on restart).
MEMORY_FINGERPRINT_THRESHOLD_BITS=12

# --- Wiring between services ---
RUNNER_PORT=8787
ALLOWED_ORIGIN=http://localhost:3000
FLAKEMART_URL=http://localhost:3100
NEXT_PUBLIC_RUNNER_URL=http://localhost:8787
