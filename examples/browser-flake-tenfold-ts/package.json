{
  "name": "browser-flake-tenfold-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tenfold: run a plain-English test plan N times in parallel on real cloud Chrome and report the flake rate, not pass/fail.",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev:runner": "pnpm --filter runner dev",
    "dev:web": "pnpm --filter web dev",
    "dev:flakemart": "pnpm --filter flakemart dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "tenfold": "pnpm --filter core exec tsx src/cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0"
  },
  "packageManager": "pnpm@9.12.0"
}
